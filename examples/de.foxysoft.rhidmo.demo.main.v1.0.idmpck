/**
 * Validates that MX_VALIDTO is not before MX_VALIDFROM on submitting a form.
 * If validation fails, displays a language-specific error message
 * that depends on the logged in user's language.
 *
 * @param   {java.util.Locale} locale - Java object with language and language country of logged in user who submits the form
 * @param   {int} subjectMSKEY - MSKEY of logged in user who submits the form
 * @param   {int} objectMSKEY - MSKEY of entry the form is invoked on, e.g. user or role whose data is being edited
 * @param   {Packages.com.sap.idm.extension.api.Task} task - Java object with metadata like GUID, ID and name of the form being submitted
 * @param   {Packages.com.sap.idm.extension.api.IdMSubmitData} validate - Java object containing form attributes and their values as entered by user
 *
 * @returns {Packages.com.sap.idm.extension.api.IdMValueChange[]} in case validation succeeds: Java array of attribute value changes to commit to database
 * @throws  {Packages.com.sap.idm.extension.IdMExtensionException} in case validation fails: Java exception containing error messages to be displayed in UI
 * @requires rhidmo_util_formatMessage
 */
function rhidmo_onSubmit_checkValidToNotBeforeValidFrom(locale, subjectMSKEY, objectMSKEY, task, validate) {
    var dateFormat = new java.text.SimpleDateFormat("yyyy-MM-dd");
    var strValidTo;
    var datValidto;
    var strValidFrom;
    var datValidFrom;

    /**
     * @type {Packages.com.sap.idm.extension.api.IdMValueChange[]}
     */
    var changeList = validate.getChangeList();

    for (var i = 0; i &lt; changeList.length; i++) {

        /**
         * @type {Packages.com.sap.idm.extension.api.IdMValueChange}
         */
        var valueChange = changeList[i];

        /**
         * @type {java.lang.String}
         */
        var attributeName = valueChange.getAttributeName();

        if ("MX_VALIDTO" == attributeName) {

            /**
             * @type {java.lang.String}
             */
            strValidTo = valueChange.getAttributeValue().trim();

            /**
             * @type {java.util.Date}
             */
            datValidto = dateFormat.parse(strValidTo);

        } else if ("MX_VALIDFROM" == attributeName) {

            /**
             * @type {java.lang.String}
             */
            strValidFrom = valueChange.getAttributeValue().trim();

            /**
             * @type {java.util.Date}
             */
            datValidFrom = dateFormat.parse(strValidFrom);

        } else {
            // Other attribute
        }

    } //for (var i = 0; i &lt; changeList.length; i++)

    if (datValidto &amp;&amp; datValidFrom) {

        if (datValidto.before(datValidFrom)) {
            var templateId = "RHIDMO_DEMO_1";
            var msgParams = [datValidFrom, datValidto];
            var fallbackText = "Valid from date {0,date,M/d/yyyy} is after valid to date {1,date,M/d/yyyy}";

            var strMessage = rhidmo_util_formatMessage(templateId, locale, msgParams, fallbackText);
            var excMessage = new Packages.com.sap.idm.extension.IdMExtensionException(strMessage);

            throw excMessage;
        }
    }

    return changeList;
}</MCSCRIPTDEFINITION>
<MCSCRIPTLANGUAGE>JScript</MCSCRIPTLANGUAGE>
