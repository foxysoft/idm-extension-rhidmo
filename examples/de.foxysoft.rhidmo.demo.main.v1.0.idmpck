/**
 * Replaces current value of MX_VALIDFROM with today's date when a form is first loaded.
 *
 * @param   {java.util.Locale} locale - Java object with language and language country of logged in user who loads the form
 * @param   {int} subjectMSKEY - MSKEY of logged in user who submits the form
 * @param   {int} objectMSKEY - MSKEY of entry the form is invoked on, e.g. user or role whose data is being edited
 * @param   {Packages.com.sap.idm.extension.api.Task} task - Java object with metadata like GUID, ID and name of the form being submitted
 * @param   {Packages.com.sap.idm.extension.api.IdMLoadData} data - Java object containing form attributes and their values as loaded from database
 * @returns {Packages.com.sap.idm.extension.api.IdMValue[]} - Java array containing attributes changed by this function, if any
 */
function rhidmo_onLoad_setValidFromToday(locale, subjectMSKEY, objectMSKEY, task, data) {
    // importClass is merely a convenience for addressing a Java class
    // later on in this function using its name only, but without its fully qualified package name
    importClass(Packages.com.sap.idm.extension.api.IdMValue);

    var changeList = new java.util.ArrayList();
    var loadedValues = data.getValues();

    // First collect our attribute changes into an ArrayList that can grow as needed.
    // This is a flexible pattern you can use in any onLoad scripts, no matter how
    // many changes they perform. In this specific case, we always perform zero or one change.
    for (var i = 0; i &lt; loadedValues.length; i++) {
        var loadedValue = loadedValues[i];
        if ("MX_VALIDFROM" == loadedValue.getAttributeName()) {

            var dateFormat = new java.text.SimpleDateFormat("yyyy-MM-dd");
            var todayIso8601 = dateFormat.format(new java.util.Date());
            loadedValue.replaceValue(todayIso8601);
            changeList.add(loadedValue);
        }
    }

    // When finished, copy the ArrayList of all attribute changes performed
    // into a new fixed-size Java array of IdMValue...
    var tmpArray = java.lang.reflect.Array.newInstance(IdMValue, changeList.size());
    var changeArray = changeList.toArray(tmpArray);

    // ...and return that Java array
    return changeArray;
}</MCSCRIPTDEFINITION>
<MCSCRIPTLANGUAGE>JScript</MCSCRIPTLANGUAGE>
