/**
 * Decode a byte array represented as hex-encoded string and convert that into a string
 * using the provided encoding, or the Java runtime's default encoding.
 *
 * @param {string|java.lang.String} hex - hex-encoded bytes, optionally with prefix "{HEX}"
 * @param {string|java.lang.String} [encoding=platform default] name of character encoding, e.g. "UTF-8"
 * @returns {string} decoded JavaScript string or error message prefixed with "!ERROR"
 */
function rhidmo_util_fromHex(hex, encoding) {

    if (!hex) {
        return "!ERROR: Parameter hex is mandatory";
    }

    // Make sure hex is a JavaScript string
    hex = ("" + hex);

    var PREFIX = "{HEX}";
    if (hex.indexOf(PREFIX) == 0) {
        hex = hex.substring(PREFIX.length);
    }

    if (hex.length % 2 != 0) {
        return "!ERROR: Hex string must have even length";
    }

    var len = hex.length;
    var decodedBytes = java.lang.reflect.Array.newInstance(java.lang.Byte.TYPE, len / 2);

    // Cannot explicitly cast from int to byte in Mozilla Rhino, hence use a Java ByteBuffer
    // for accessing the individual bytes making up a Java integer
    var bytesOfOneInteger = java.nio.ByteBuffer.allocate(4);

    for (var i = 0; i &lt; len; i += 2) {
        var hi = parseInt(hex[i], 16);
        if (isNaN(hi)) {
            return "!ERROR: high byte is not a valid hex digit: " + hex[i];
        }

        var lo = parseInt(hex[i + 1], 16);
        if (isNaN(lo)) {
            return "!ERROR: low byte is not a valid hex digit: " + hex[i + 1];
        }

        var uint = ((hi &lt;&lt; 4) + lo) &amp; 0xFF;

        // Type conversion: JavaScript number to 4-byte Java integer
        bytesOfOneInteger.clear().putInt(uint);

        // Get least significant byte from index 3 (ByteBuffer stores as big endian)
        decodedBytes[i / 2] = bytesOfOneInteger.array()[3];
    }

    var charset;
    if (encoding) {
        try {
            charset = java.nio.charset.Charset.forName(encoding);
        } catch (e) {
            return "!ERROR: Unsupported charset [" + encoding + "]";
        }
    } else {
        charset = java.nio.charset.Charset.defaultCharset();
    }

    var decodedStringJava = new java.lang.String(decodedBytes, charset);
    var decodedStringJs = ("" + decodedStringJava);

    return decodedStringJs;
}</MCSCRIPTDEFINITION>
<MCSCRIPTLANGUAGE>JScript</MCSCRIPTLANGUAGE>
