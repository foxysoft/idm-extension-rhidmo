 * License for the specific language governing permissions and limitations under
 * the License.
 ******************************************************************************/

/**
 * Use templateId to look up a message template from database table MC_TEMPLATES
 * in the language and language country provided by locale. Then format this template
 * using the parameters provided in msgParams.
 *
 * Technically, parameter replacement is implemented using java.text.MessageFormat
 * Please check parameter syntax and quoting rules at:
 * https://docs.oracle.com/javase/8/docs/api/java/text/MessageFormat.html
 *
 * @param {string|java.lang.String} templateId - template ID as in database table MC_TEMPLATES.MCID
 * @param {java.util.Locale} locale - Java locale object to determine language and language country
 * @param {Array|java.lang.Object[]} [msgParams] - optional message parameters
 * @param {string|java.lang.String} [fallbackText] - optional fallback template text when no matching template is found in database
 * @returns {string} localized template text with parameters filled in or error message prefixed with "!ERROR"
 * @requires rhidmo_util_fromHex
 */
function rhidmo_util_formatMessage(templateId, locale, msgParams, fallbackText) {
    var messageStringJava;
    var messageStringJs;

    // In SAP(R) NetWeaver, both language and country are contained in the return value of getLanguage()
    var sapLocaleValue = locale.getLanguage();
    var language;
    var languageCountry;

    var matches = /^([^_]+)_?([^_]+)?.*$/.exec(sapLocaleValue);
    if (matches != null) {
        language = matches[1] ? matches[1].toUpperCase() : "";
        languageCountry = matches[2] ? matches[2].toUpperCase() : "";
    }

    if (!language) {
        uWarning("Locale doesn't specify any language - using EN as fallback");
        language="EN";
    }

    var templateHex;
    var templateStr;
    var sql;

    // 1. Try lookup with locale language and country if we have both
    if (languageCountry) {
        sql = "select mctemplate from mc_templates where mcid='" + templateId + "' and mclanguage='" + language + "'" + " and mclanguagecountry='" + languageCountry + "'";
        templateHex = uSelect(sql);
    }

    // 2. If not found, try lookup with locale language and NULL country
    if (!templateHex) {
        sql = "select mctemplate from mc_templates where mcid='" + templateId + "' and mclanguage='" + language + "'" + " and mclanguagecountry is null";
        templateHex = uSelect(sql);
    }

    // 3. If still not found, try caller-provided fallback text, if supplied
    if (!templateHex) {
        if (fallbackText) {
            uWarning("Template [" + templateId + "] not found for locale [" + locale + "]; using fallback text");
            templateStr = fallbackText;
        }
        // or give up if not supplied
        else {
            return "!ERROR: Template [" + templateId + "] not found for locale [" + locale + "] and no fallback text provided";
        }
    } else {
        templateStr = rhidmo_util_fromHex(templateHex);
        if (templateStr.indexOf("!ERROR") == 0) {

            // Hex-decoding failed, return error message as is
            return templateStr;
        }
    }

    var mf = new java.text.MessageFormat(templateStr, locale);
    messageStringJava = mf.format(msgParams, new java.lang.StringBuffer(), null).toString();
    messageStringJs = ("" + messageStringJava);

    return messageStringJs;
}</MCSCRIPTDEFINITION>
<MCSCRIPTLANGUAGE>JScript</MCSCRIPTLANGUAGE>
<MCSCRIPTLASTCHANGE>1748957653986</MCSCRIPTLASTCHANGE>
<MCSCRIPTNAME>rhidmo_util_formatMessage</MCSCRIPTNAME>
<MCSCRIPTSTATUS>0</MCSCRIPTSTATUS>
</SCRIPT>
<SCRIPT>
<MCENABLED>1</MCENABLED>
<MCPACKAGEID>de.foxysoft.rhidmo.demo.util</MCPACKAGEID>
